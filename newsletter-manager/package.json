{
  "name": "ho-me-newsletter-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop manager for the Ho-me newsletter archive",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . NewsletterManager --platform=win32 --arch=x64 --out=dist --overwrite --ignore=^/dist$ --ignore=test-.*\\.cjs --ignore=smoke-.*\\.png --ignore=web-bridge\\.js",
    "build-admin": "node build-admin.cjs",
    "smoke": "node test-drive.cjs",
    "test-api": "node test-api.cjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.1",
    "playwright-core": "^1.64.1"
  }
}
